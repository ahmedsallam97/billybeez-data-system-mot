{
  "scripts": {
    "dev": "next dev --webpack -H 127.0.0.1 -p 3008",
    "build": "npm run db:clients && next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "test": "node --test",
    "lint": "node scripts/ui-audit.js",
    "db:push": "prisma db push",
    "db:clients": "prisma generate && node scripts/generate-postgres-client.js",
    "db:pg:validate": "node scripts/validate-postgres-schema.js",
    "db:pg:sync-schema": "node scripts/sync-postgres-schema.js",
    "db:pg:generate": "node scripts/generate-postgres-client.js",
    "db:pg:migrate": "prisma migrate deploy --schema prisma/postgres/schema.prisma",
    "db:pg:status": "prisma migrate status --schema prisma/postgres/schema.prisma",
    "db:seed": "node scripts/seed.js",
    "db:hash-passwords": "node scripts/hash-passwords.js",
    "db:backup": "node scripts/backup-db.js",
    "db:restore": "node scripts/restore-db.js",
    "db:verify-backup": "node scripts/verify-backup.js",
    "db:studio": "prisma studio --port 5555",
    "db:migrate-workflow": "node scripts/migrate-workflow-state.js",
    "settings:migrate-operations": "node scripts/migrate-operations-settings.js",
    "rotation:repair-conflicts": "node scripts/repair-rotation-conflicts.js --apply",
    "storage:verify": "node scripts/verify-employee-file-storage.js",
    "storage:cleanup": "node scripts/cleanup-employee-files.js",
    "storage:cleanup:apply": "node scripts/cleanup-employee-files.js --apply",
    "products:images": "node scripts/sync-product-images.js",
    "products:cleanup-quick-duplicates": "node scripts/cleanup-quick-product-duplicates.js",
    "items:import": "node scripts/import-items-categories.js",
    "db:import:apps-script": "node scripts/import-apps-script.js",
    "clasp:push": "clasp push --force",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@fontsource/tajawal": "^5.2.7",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^6.19.1",
    "bcryptjs": "^3.0.3",
    "html-to-image": "^1.11.13",
    "next": "^16.2.9",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.19.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "read-excel-file": "^9.3.1"
  },
  "devDependencies": {
    "@google/clasp": "^3.3.0",
    "@playwright/test": "^1.63.0"
  },
  "prisma": {
    "seed": "node scripts/seed.js"
  }
}
