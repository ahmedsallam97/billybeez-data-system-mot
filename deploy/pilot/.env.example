# NON-SECRET deployment coordinates. Real copies and secrets are git-ignored.
RELEASE_REVISION=replace-with-reviewed-git-commit
PILOT_HOST=replace-with-your-subdomain.duckdns.org
ACME_EMAIL=replace-with-owner-email
PILOT_SECRETS_DIR=/etc/operations-pilot
PILOT_DATA_DIR=/srv/operations-data/generations/initial-pilot
PILOT_BACKUP_DIR=/srv/operations-data/backups
