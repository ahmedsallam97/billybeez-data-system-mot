model User {
  id         String   @id @default(cuid())
  name       String
  username   String   @unique
  password   String
  role       Role
  active     Boolean  @default(true)
  employeeId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee  Employee?  @relation("EmployeeLoginUsers", fields: [employeeId], references: [id], onDelete: SetNull)
  orders    Order[]    @relation("CashierOrders")
  auditLogs AuditLog[]

  @@index([employeeId])
}

model Employee {
  id                   String           @id @default(cuid())
  name                 String           @unique
  nameAr               String?
  nameEn               String?
  operationalName      String?
  gender               String?
  operationsTeamLeader Boolean          @default(false)
  sourceEmployeeId     String?          @unique
  hrisNumber           String?          @unique
  localEmployeeCode    String?          @unique
  nationalId           String?          @unique
  jobTitle             String?
  employmentType       EmploymentType   @default(OTHER)
  employmentStatus     EmploymentStatus @default(ACTIVE)
  hireDate             DateTime?
  joinDate             DateTime?
  department           Department       @default(OPERATION)
  branch               String?
  dateOfBirth          DateTime?
  phone                String?
  address              String?
  emergencyName        String?
  emergencyPhone       String?
  emergencyRelation    String?
  personalNotes        String?
  supervisorId         String?
  photoDocumentId      String?
  active               Boolean          @default(true)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  dataOrders           Order[]                      @relation("OrderDataEmployee")
  deliveryOrders       Order[]                      @relation("OrderDeliveryEmployee")
  geideaOrders         Order[]                      @relation("OrderGeideaEmployee")
  paymentOrders        Order[]                      @relation("OrderPaymentEmployee")
  exitOrders           Order[]                      @relation("OrderExitEmployee")
  loginUsers           User[]                       @relation("EmployeeLoginUsers")
  employmentPeriods    EmploymentPeriod[]
  assignments          EmploymentAssignment[]
  weeklyOffPatterns    WeeklyOffPattern[]
  scheduleAssignments  OpsScheduleAssignment[]
  attendanceRecords    OpsAttendanceRecord[]
  leaveAccounts        OpsLeaveAccount[]
  leaveBookings        OpsLeaveBooking[]
  overtimeAccount      OpsOvertimeAccount?
  overtimeTransactions OpsOvertimeTransaction[]
  rotationAssignments  OpsRotationAssignment[]
  breakAssignments     OpsBreakAssignment[]
  dailyEvaluations     OpsEmployeeDailyEvaluation[]
  monthlyAppraisals    OpsMonthlyAppraisal[]
  competitionEntries   OpsEotmCandidate[]
  eotmWins             OpsEotmCompetition[]         @relation("OpsEotmWinner")
  successionCandidates OpsSuccessionCandidate[]
  documents            EmployeeDocument[]
  employmentEvents     EmployeeEmploymentEvent[]
  trainingRecords      EmployeeTrainingRecord[]
  qualifications       EmployeeQualification[]
  guestFeedback        EmployeeGuestFeedback[]
  guidanceRecords      EmployeeGuidanceRecord[]
  incidents            EmployeeIncident[]

  @@index([employmentType, employmentStatus])
  @@index([jobTitle])
}

model EmployeeDocument {
  id             String    @id @default(cuid())
  employeeId     String
  documentType   String
  displayName    String
  storageKey     String    @unique
  mimeType       String
  sizeBytes      Int
  issueDate      DateTime?
  expiryDate     DateTime?
  status         String    @default("ACTIVE")
  classification String    @default("INTERNAL")
  notes          String?
  uploadedBy     String?
  uploadedAt     DateTime  @default(now())
  replacedById   String?
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, documentType])
  @@index([expiryDate])
}

model EmployeeEmploymentEvent {
  id            String   @id @default(cuid())
  employeeId    String
  eventType     String
  effectiveDate DateTime
  previousValue String?
  newValue      String?
  reason        String?
  createdBy     String?
  createdAt     DateTime @default(now())
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, effectiveDate])
}

model EmployeeTrainingRecord {
  id            String    @id @default(cuid())
  employeeId    String
  name          String
  category      String?
  completedDate DateTime?
  expiryDate    DateTime?
  status        String    @default("COMPLETED")
  provider      String?
  certificateId String?
  notes         String?
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, completedDate])
  @@index([expiryDate])
}

model EmployeeQualification {
  id                    String                 @id @default(cuid())
  employeeId            String
  operationalPositionId String
  status                String                 @default("NOT_QUALIFIED")
  effectiveDate         DateTime?
  expiryDate            DateTime?
  notes                 String?
  createdBy             String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  employee              Employee               @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  position              OpsOperationalPosition @relation(fields: [operationalPositionId], references: [id], onDelete: Restrict)

  @@unique([employeeId, operationalPositionId])
  @@index([operationalPositionId, status])
}

model EmployeeGuestFeedback {
  id           String   @id @default(cuid())
  employeeId   String
  feedbackDate DateTime
  source       String   @default("GUEST")
  guestName    String?
  guestPhone   String?
  rating       Int?
  category     String?
  comment      String
  followUp     String?
  status       String   @default("OPEN")
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, feedbackDate])
  @@index([status])
}

model EmployeeGuidanceRecord {
  id           String    @id @default(cuid())
  employeeId   String
  recordDate   DateTime
  recordType   String
  title        String
  details      String?
  points       Float?
  actionTaken  String?
  followUpDate DateTime?
  status       String    @default("OPEN")
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, recordDate])
  @@index([recordType, status])
}

model EmployeeIncident {
  id              String    @id @default(cuid())
  employeeId      String
  incidentDate    DateTime
  incidentType    String
  title           String
  description     String?
  severity        String    @default("MEDIUM")
  location        String?
  peopleInvolved  String?
  immediateAction String?
  followUpAction  String?
  status          String    @default("OPEN")
  closedAt        DateTime?
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, incidentDate])
  @@index([severity, status])
}

model Category {
  id                String            @id
  name              String
  department        ProductDepartment @default(KITCHEN)
  color             String?
  availabilityRules String?
  active            Boolean           @default(true)
  showInDataOrder   Boolean           @default(true)
  showInQuickOrder  Boolean           @default(true)
  sortOrder         Int               @default(100)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  products Product[]

  @@index([department])
  @@index([department, active])
}

model Product {
  id                String            @id
  name              String
  price             Float
  originalPrice     Float?
  netSales          Float?
  taxAmount         Float?
  taxRate           Float?
  department        ProductDepartment @default(KITCHEN)
  etaItemCode       String?
  etaCodeType       String?
  etaUnitType       String?
  etaTaxType        String?
  etaTaxSubType     String?
  imageUrl          String?
  iconText          String?
  cardColorStart    String?
  cardColorEnd      String?
  cardTextColor     String?
  cardAccentColor   String?
  availabilityRules String?
  active            Boolean           @default(true)
