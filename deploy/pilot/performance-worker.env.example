# Keep disabled until the staging plan and verified backup are approved.
OPS_PERFORMANCE_WORKER_ENABLED=0
OPS_PERFORMANCE_WORKER_USER_ID=
OPS_PERFORMANCE_WORKER_BRANCH=MOT
OPS_PERFORMANCE_WORKER_INTERVAL_SECONDS=300
# Use exactly the application's persistent DATABASE_URL and storage configuration.
# Never create or seed a separate worker database.
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:/srv/operations/database/operations.db
EMPLOYEE_FILE_STORAGE_PROVIDER=local
EMPLOYEE_FILE_STORAGE_ROOT=/srv/operations/employee-files
