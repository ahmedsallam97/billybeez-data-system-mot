DATABASE_URL="file:./dev.db"
SESSION_SECRET="<generate-a-random-value-of-at-least-32-characters>"
AUTH_COOKIE_NAME="billybeez_session"
COOKIE_SECURE="false"

# Optional PostgreSQL deployment target. Validate and migrate on an isolated database first.
POSTGRES_DATABASE_URL="<optional-postgresql-connection-url>"

# Protected employee-file storage. Local remains the default for this workstation.
EMPLOYEE_FILE_STORAGE_PROVIDER="local"
EMPLOYEE_FILE_STORAGE_ROOT="<optional-absolute-local-storage-path>"

# Set these only when EMPLOYEE_FILE_STORAGE_PROVIDER="s3". Values may target AWS S3
# or a compatible private object store. Never commit real credentials.
EMPLOYEE_FILE_S3_BUCKET="<optional-bucket-name>"
EMPLOYEE_FILE_S3_REGION="<optional-region>"
EMPLOYEE_FILE_S3_ENDPOINT="<optional-s3-compatible-endpoint>"
EMPLOYEE_FILE_S3_PREFIX="employee-files"
EMPLOYEE_FILE_S3_ACCESS_KEY_ID="<optional-access-key-id>"
EMPLOYEE_FILE_S3_SECRET_ACCESS_KEY="<optional-secret-access-key>"
EMPLOYEE_FILE_S3_FORCE_PATH_STYLE="false"
EMPLOYEE_FILE_S3_SSE="<optional-server-side-encryption-mode>"

# Required only when deliberately running npm run db:seed on a disposable/fresh database.
# Use unique values of at least 12 characters. Never commit real values.
SEED_ADMIN_PASSWORD="<set-before-seeding>"
SEED_MANAGER_PASSWORD="<set-before-seeding>"
SEED_DATA_PASSWORD="<set-before-seeding>"
SEED_CASHIER_PASSWORD="<set-before-seeding>"
SEED_KITCHEN_PASSWORD="<set-before-seeding>"
SEED_EMPLOYEE_PASSWORD="<set-before-seeding>"
