DATABASE_URL="file:./dev.db"
SESSION_SECRET="<generate-a-random-value-of-at-least-32-characters>"
AUTH_COOKIE_NAME="billybeez_session"
COOKIE_SECURE="false"

# Optional. Configure only after prisma/schema.postgres.prisma is reconciled
# with the authoritative SQLite schema and validated on an isolated database.
POSTGRES_DATABASE_URL="<optional-postgresql-connection-url>"
