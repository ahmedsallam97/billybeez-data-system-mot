# Private OCI Object Storage bucket, restricted to this backup prefix.
# Local-only backups are refused by the scheduled job unless explicitly in a drill.
BACKUP_S3_ENDPOINT=https://YOUR_NAMESPACE.compat.objectstorage.YOUR_REGION.oraclecloud.com
BACKUP_S3_REGION=YOUR_REGION
BACKUP_S3_BUCKET=operations-pilot-backups
BACKUP_S3_PREFIX=operations-pilot
BACKUP_S3_ACCESS_KEY_ID=replace-on-server-only
BACKUP_S3_SECRET_ACCESS_KEY=replace-on-server-only
