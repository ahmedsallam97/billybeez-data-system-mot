  reviews             OpsSuccessionReview[]

  @@unique([employeeId, targetRole, active])
  @@index([targetRole, readinessStatus, active])
}

model OpsSuccessionDevelopmentAction {
  id             String                 @id @default(cuid())
  sourceId       String?                @unique
  candidateId    String
  competency     String
  note           String?
  status         OpsDevelopmentStatus   @default(NOT_STARTED)
  targetDate     String?
  completionDate String?
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  candidate      OpsSuccessionCandidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)
}

model OpsSuccessionReview {
  id                String                 @id @default(cuid())
  sourceId          String?                @unique
  candidateId       String
  previousReadiness OpsSuccessionReadiness
  newReadiness      OpsSuccessionReadiness
  reviewDate        DateTime               @default(now())
  notes             String?
  reviewedBy        String?
  createdAt         DateTime               @default(now())
  candidate         OpsSuccessionCandidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)
}
