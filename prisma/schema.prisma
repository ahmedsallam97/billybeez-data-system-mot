generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
  KITCHEN
  DATA
}

enum Department {
  OPERATION
  CASHIER
  KITCHEN
}

enum OrderStatus {
  OPEN
  DELIVERED
  PAID
  ARCHIVED
}

enum WorkflowState {
  OPEN
  PREPARING
  DELIVERED
  PAID
  GEIDEA_REGISTERED
  CUSTOMER_LEFT
  ARCHIVED
}

enum KitchenStatus {
  PENDING
  DELIVERED
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum PaymentMethod {
  CASH
  VISA
  KIDZAPP
  WAFFARHA
  E_INVOICE
  CUSTOM_1
  CUSTOM_2
}

enum ProductDepartment {
  ENTRANCE
  KITCHEN
  KITCHEN_CASHIER
}

enum DeviceType {
  FRONT
  KITCHEN
  KITCHEN_CASHIER
}

enum PaymentProviderType {
  CASH
  VISA
  CUSTOM
}

enum PrintJobType {
  KITCHEN
  INVOICE
}

enum PrintJobStatus {
  PENDING
  PRINTED
  FAILED
}

model User {
  id         String   @id @default(cuid())
  name       String
  username   String   @unique
  password   String
  role       Role
  active     Boolean  @default(true)
  employeeId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee  Employee?  @relation("EmployeeLoginUsers", fields: [employeeId], references: [id], onDelete: SetNull)
  orders    Order[]    @relation("CashierOrders")
  auditLogs AuditLog[]

  @@index([employeeId])
}

model Employee {
  id         String     @id @default(cuid())
  name       String     @unique
  department Department @default(OPERATION)
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  dataOrders     Order[] @relation("OrderDataEmployee")
  deliveryOrders Order[] @relation("OrderDeliveryEmployee")
  geideaOrders   Order[] @relation("OrderGeideaEmployee")
  paymentOrders  Order[] @relation("OrderPaymentEmployee")
  exitOrders     Order[] @relation("OrderExitEmployee")
  loginUsers     User[]  @relation("EmployeeLoginUsers")
}

model Category {
  id                String            @id
  name              String
  department        ProductDepartment @default(KITCHEN)
  color             String?
  availabilityRules String?
  active            Boolean           @default(true)
  showInDataOrder   Boolean           @default(true)
  showInQuickOrder  Boolean           @default(true)
  sortOrder         Int               @default(100)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  products Product[]

  @@index([department])
  @@index([department, active])
}

model Product {
  id                String            @id
  name              String
  price             Float
  originalPrice     Float?
  netSales          Float?
  taxAmount         Float?
  taxRate           Float?
  department        ProductDepartment @default(KITCHEN)
  etaItemCode       String?
  etaCodeType       String?
  etaUnitType       String?
  etaTaxType        String?
  etaTaxSubType     String?
  imageUrl          String?
  iconText          String?
  cardColorStart    String?
  cardColorEnd      String?
  cardTextColor     String?
  cardAccentColor   String?
  availabilityRules String?
  active            Boolean           @default(true)
  popular           Boolean           @default(false)
  printOnKitchen    Boolean           @default(true)
  showInDataOrder   Boolean           @default(true)
  showInQuickOrder  Boolean           @default(true)
  sortOrder         Int               @default(100)
  categoryId        String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  category Category    @relation(fields: [categoryId], references: [id])
  items    OrderItem[]

  @@index([department])
  @@index([department, active])
}

model Order {
  id                 String        @id
  businessDate       String?
  invoiceSerial      String?       @unique
  deviceId           String?
  customerId         String?
  customerName       String?
  braceletNo         String
  customerPhone      String?
  childNames         String
  childrenCount      Int           @default(1)
  allowOpenCharges   Boolean       @default(false)
  comments           String?
  total              Float         @default(0)
  status             OrderStatus   @default(OPEN)
  workflowState      WorkflowState @default(OPEN)
  kitchenStatus      KitchenStatus @default(PENDING)
  paymentStatus      PaymentStatus @default(UNPAID)
  paymentMethod      PaymentMethod @default(CASH)
  paymentProviderId  String?
  customerLeft       Boolean       @default(false)
  customerLeftAt     DateTime?
  geideaRegisteredAt DateTime?
  etaUuid            String?
  etaSubmissionId    String?
  etaStatus          String?
  etaQrCode          String?
  internalQrPayload  String?
  archivedAt         DateTime?
  cashierId          String?
  dataEmployeeId     String?
  deliveryEmployeeId String?
  geideaEmployeeId   String?
  paymentEmployeeId  String?
  exitEmployeeId     String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  device             Device?             @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  paymentProvider    PaymentProvider?    @relation(fields: [paymentProviderId], references: [id], onDelete: SetNull)
  cashier            User?               @relation("CashierOrders", fields: [cashierId], references: [id])
  dataEmployee       Employee?           @relation("OrderDataEmployee", fields: [dataEmployeeId], references: [id])
  deliveryEmployee   Employee?           @relation("OrderDeliveryEmployee", fields: [deliveryEmployeeId], references: [id])
  geideaEmployee     Employee?           @relation("OrderGeideaEmployee", fields: [geideaEmployeeId], references: [id])
  paymentEmployee    Employee?           @relation("OrderPaymentEmployee", fields: [paymentEmployeeId], references: [id])
  exitEmployee       Employee?           @relation("OrderExitEmployee", fields: [exitEmployeeId], references: [id])
  items              OrderItem[]
  children           Child[]
  payments           OrderPayment[]
  auditLogs          AuditLog[]
  printJobs          PrintJob[]
  activeBraceletLock ActiveBraceletLock?

  @@index([invoiceSerial])
  @@index([deviceId])
  @@index([customerId])
  @@index([businessDate])
  @@index([workflowState])
  @@index([archivedAt])
  @@index([archivedAt, createdAt])
  @@index([braceletNo, archivedAt])
  @@index([geideaRegisteredAt])
}

model ActiveBraceletLock {
  braceletNo String   @id
  orderId    String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  name      String
  qty       Int      @default(1)
  price     Float
  netSales  Float?
  taxAmount Float?
  total     Float
  createdAt DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  comments  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  children Child[]
  orders   Order[]

  @@index([phone])
  @@index([name])
}

model Child {
  id               String    @id @default(cuid())
  customerId       String?
  orderId          String?
  name             String
  birthDate        DateTime?
  comments         String?
  allowOpenCharges Boolean   @default(false)
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  order    Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([orderId])
  @@index([name])
}

model Device {
  id                 String     @id
  deviceNo           Int        @unique
  name               String
  type               DeviceType @default(FRONT)
  active             Boolean    @default(true)
  invoicePrinterName String?
  kitchenPrinterName String?
  posSerial          String?
  branchCode         String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  orders Order[]

  @@index([type])
  @@index([active])
}

model PaymentProvider {
  id               String              @id
  name             String
  type             PaymentProviderType @default(CUSTOM)
  method           PaymentMethod
  active           Boolean             @default(true)
  editable         Boolean             @default(true)
  showInFrontOrder Boolean             @default(true)
  showInDataOrder  Boolean             @default(true)
  showInQuickOrder Boolean             @default(true)
  sortOrder        Int                 @default(100)
  reportBucket     String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  orders   Order[]
  payments OrderPayment[]

  @@index([type])
  @@index([active])
}

model OrderPayment {
  id                String        @id @default(cuid())
  orderId           String
  paymentProviderId String?
  method            PaymentMethod
  amount            Float
  reference         String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentProvider PaymentProvider? @relation(fields: [paymentProviderId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([paymentProviderId])
  @@index([method])
}

model OrderTransactionRecord {
  id                               String    @id @default(cuid())
  orderId                          String    @unique
  businessDate                     String?
  braceletNo                       String
  childNames                       String?
  orderTotal                       Float     @default(0)
  orderCreatedAt                   DateTime?
  orderCreatedByUserId             String?
  orderCreatedByUserName           String?
  orderCreatedByEmployeeId         String?
  orderCreatedByEmployeeName       String?
  preparationStartedAt             DateTime?
  preparationStartedByUserId       String?
  preparationStartedByUserName     String?
  preparationStartedByEmployeeId   String?
  preparationStartedByEmployeeName String?
  deliveredAt                      DateTime?
  deliveredByUserId                String?
  deliveredByUserName              String?
  deliveredByEmployeeId            String?
  deliveredByEmployeeName          String?
  paidAt                           DateTime?
  paymentMethod                    String?
  paidByUserId                     String?
  paidByUserName                   String?
  paidByEmployeeId                 String?
  paidByEmployeeName               String?
  geideaRegisteredAt               DateTime?
  geideaByUserId                   String?
  geideaByUserName                 String?
  geideaByEmployeeId               String?
  geideaByEmployeeName             String?
  customerLeftAt                   DateTime?
  customerLeftByUserId             String?
  customerLeftByUserName           String?
  customerLeftByEmployeeId         String?
  customerLeftByEmployeeName       String?
  archivedAt                       DateTime?
  createdAt                        DateTime  @default(now())
  updatedAt                        DateTime  @updatedAt

  @@index([braceletNo])
  @@index([businessDate])
  @@index([createdAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  orderId        String?
  orderReference String?
  userId         String?
  action         String
  summary        String?
  metadata       String?
  createdAt      DateTime @default(now())

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderReference])
  @@index([createdAt])
}

model PrintJob {
  id           String         @id @default(cuid())
  orderId      String
  type         PrintJobType
  status       PrintJobStatus @default(PENDING)
  ticketNumber Int?
  printerName  String?
  payload      String
  error        String?
  printedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([type])
  @@index([ticketNumber])
  @@index([createdAt])
}

model BusinessDay {
  id               String    @id @default(cuid())
  businessDate     String    @unique
  openedAt         DateTime?
  closedAt         DateTime?
  closedOrderCount Int       @default(0)
  closedTotal      Float     @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model SystemSetting {
  key         String   @id
  value       String
  description String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DailyClosingSnapshot {
  id                   String   @id @default(cuid())
  businessDate         String   @unique
  ordersCount          Int      @default(0)
  paidOrdersCount      Int      @default(0)
  unpaidOrdersCount    Int      @default(0)
  cashTotal            Float    @default(0)
  visaTotal            Float    @default(0)
  unpaidTotal          Float    @default(0)
  notRegisteredGeidea  Int      @default(0)
  leftUnpaid           Int      @default(0)
  archivedOrdersCount  Int      @default(0)
  topProductsJson      String   @default("[]")
  paymentBreakdownJson String   @default("[]")
  statusBreakdownJson  String   @default("[]")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model CounterSequence {
  name      String   @id
  value     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderHistory {
  id                   String    @id @default(cuid())
  originalOrderId      String    @unique
  businessDate         String
  braceletNo           String
  customerPhone        String?
  childNames           String
  childrenCount        Int
  allowOpenCharges     Boolean   @default(false)
  total                Float
  status               String
  kitchenStatus        String
  paymentStatus        String
  paymentMethod        String
  customerLeft         Boolean
  customerLeftAt       DateTime?
  cashierName          String?
  dataEmployeeName     String?
  deliveryEmployeeName String?
  geideaEmployeeName   String?
  paymentEmployeeName  String?
  exitEmployeeName     String?
  geideaRegisteredAt   DateTime?
  itemsJson            String
  orderCreatedAt       DateTime
  orderUpdatedAt       DateTime
  archivedAt           DateTime?
  closedAt             DateTime
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([businessDate])
  @@index([closedAt])
}
